.entry ENTRY_MOV, 0x01

; Rung 6 Pass 5A bounded MOV slice:
;   B0-B7 MOV r8, imm8
;   B8-BF MOV r32, imm32
;   88/89/8A/8B register-register only when ModRM.mod=11
; Decoder supplies OC_MOV_R_IMM, M_OPSZ, and raw M_REG_DST from opcode[2:0].
; For 88/89/8A/8B it supplies OC_MOV_RM_R or OC_MOV_R_RM, M_REG_SRC,
; M_REG_RM, and M_REG_DST. LOAD_REG_META/STORE_REG_META are bounded to
; ModRM.mod=11 metadata and do not issue memory accesses. ENDI CM_MOV_REG is
; the only architectural GPR visibility boundary.
ENTRY_MOV:
    EXTRACT T3, M_OPCODE_CLASS
    BR C_T3Z, .mov_rm_r
    EXTRACT T3, M_IMM_CLASS
    BR C_T3Z, .mov_r_rm
    BR C_W8, .mov_imm8
    SVCW FETCH_IMM32
    BR C_FAULT, SUB_FAULT_HANDLER
    STAGE STAGE_GPR, T4
    ENDI CM_MOV_REG
.mov_imm8:
    SVCW FETCH_IMM8
    BR C_FAULT, SUB_FAULT_HANDLER
    STAGE STAGE_GPR, T4
    ENDI CM_MOV_REG
.mov_rm_r:
    SVCW LOAD_REG_META
    BR C_FAULT, SUB_FAULT_HANDLER
    SVCW STORE_REG_META
    BR C_FAULT, SUB_FAULT_HANDLER
    ENDI CM_MOV_REG
.mov_r_rm:
    SVCW LOAD_REG_META
    BR C_FAULT, SUB_FAULT_HANDLER
    SVCW STORE_REG_META
    BR C_FAULT, SUB_FAULT_HANDLER
    ENDI CM_MOV_REG
