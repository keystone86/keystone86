.entry ENTRY_ALU_R_RM, 0x03

; Rung 7 bounded opposite-direction register slice:
;   03 /r ADD r32, r/m32, ModRM.mod=11 only
;   2B /r SUB r32, r/m32, ModRM.mod=11 only
;   3B /r CMP r32, r/m32, ModRM.mod=11 only
;
; Decoder supplies M_ALU_OP, M_IS_CMP, M_REG_DST, M_REG_RM, M_OPSZ=32, and
; M_NEXT_EIP. Microcode mirrors ENTRY_ALU_RM_R with reversed metadata loading:
; the architectural destination/left operand is ModRM.reg, and the source/right
; operand is ModRM.r/m. CMP suppression remains here, not in the ALU service.

.alu_fault:
    RAISE FC_UD
    BR C_ALWAYS, SUB_FAULT_HANDLER

ENTRY_ALU_R_RM:
    EXTRACT T3, M_REG_DST
    SVCW LOAD_REG_META
    BR C_FAULT, .alu_fault
    MOV T0, T4
    EXTRACT T3, M_REG_RM
    SVCW LOAD_REG_META
    BR C_FAULT, .alu_fault
    MOV T1, T4
    EXTRACT T4, M_ALU_OP
    EXTRACT T3, M_IS_CMP
    BR C_T3NZ, .cmp
    MOV T3, T4
    BR C_T3Z, .add
    SVCW ALU_SUB32
    BR C_FAULT, .alu_fault
    STAGE STAGE_EFLAGS, T3, T4
    STAGE STAGE_GPR, T0
    ENDI CM_ALU_REG
.add:
    SVCW ALU_ADD32
    BR C_FAULT, .alu_fault
    STAGE STAGE_EFLAGS, T3, T4
    STAGE STAGE_GPR, T0
    ENDI CM_ALU_REG
.cmp:
    SVCW ALU_CMP32
    BR C_FAULT, .alu_fault
    STAGE STAGE_EFLAGS, T3, T4
    ENDI CM_FLAGS
